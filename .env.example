# Environment Configuration for LPDG Gateway Predictor
# Copy to .env and modify as needed. All settings come from here, not from editing code.

# Data paths
DATA_DIR=./data
MODEL_DIR=./models
PREDICTIONS_OUT=./predictions.csv

# Logging
LOG_LEVEL=INFO

# Reproducibility
RANDOM_SEED=42

# Business constraints
VISIT_BUDGET=15
COST_FALSE_POSITIVE=380
COST_FALSE_NEGATIVE=600

# Drift detection
DRIFT_THRESHOLD=0.05

# Model selection
MODEL_VERSION=current
